<Window x:Class="MacShell.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacShell Barra" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="White"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root">
        <Border x:Name="BottomLine" VerticalAlignment="Bottom" Height="1" Background="#1AFFFFFF"/>
        <DockPanel LastChildFill="False" Margin="8,0">
            <!-- Esquerda: logo (abre o Iniciar) e nome do app em foco -->
            <Button x:Name="LogoBtn" DockPanel.Dock="Left" Style="{StaticResource BarButton}" ToolTip="Iniciar" Padding="11,0">
                <Grid Width="13" Height="13">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="2"/><RowDefinition/></Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" RadiusX="1.2" RadiusY="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Rectangle Grid.Row="0" Grid.Column="2" RadiusX="1.2" RadiusY="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Rectangle Grid.Row="2" Grid.Column="0" RadiusX="1.2" RadiusY="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Rectangle Grid.Row="2" Grid.Column="2" RadiusX="1.2" RadiusY="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
            </Button>
            <Button x:Name="AppBtn" DockPanel.Dock="Left" Style="{StaticResource BarButton}">
                <TextBlock x:Name="AppName" FontWeight="SemiBold" Text="Explorador de Arquivos"/>
            </Button>
            <Button x:Name="WindowBtn" DockPanel.Dock="Left" Style="{StaticResource BarButton}">
                <TextBlock Text="Janela"/>
            </Button>

            <!-- Direita (ordem invertida): relógio, central de controle, busca, rede, bateria -->
            <Button x:Name="ClockBtn" DockPanel.Dock="Right" Style="{StaticResource BarButton}" ToolTip="Notificações e calendário">
                <TextBlock x:Name="Clock"/>
            </Button>
            <Button x:Name="ControlBtn" DockPanel.Dock="Right" Style="{StaticResource BarButton}" ToolTip="Configurações rápidas">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE9E9;"/>
            </Button>
            <Button x:Name="SearchBtn" DockPanel.Dock="Right" Style="{StaticResource BarButton}" ToolTip="Buscar (Win+Alt+Espaço)">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE721;"/>
            </Button>
            <Button x:Name="NetBtn" DockPanel.Dock="Right" Style="{StaticResource BarButton}">
                <TextBlock x:Name="NetIcon" FontFamily="{StaticResource IconFont}" FontSize="15" Text="&#xE701;"/>
            </Button>
            <Button x:Name="SoundBtn" DockPanel.Dock="Right" Style="{StaticResource BarButton}" ToolTip="Som">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" Text="&#xE767;"/>
            </Button>
            <Button x:Name="TrayBtn" DockPanel.Dock="Right" Style="{StaticResource BarButton}" ToolTip="Programas em segundo plano (ícones ocultos)">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE70E;"/>
            </Button>
            <Button x:Name="BatteryBtn" DockPanel.Dock="Right" Style="{StaticResource BarButton}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BatteryText" Margin="0,0,5,0" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BatteryIcon" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
