<Window x:Class="MacShell.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacShell Dock" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="False">
    <Grid x:Name="Root">
        <!-- "Vidro" do dock -->
        <Border x:Name="Pill" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                CornerRadius="20" BorderThickness="1" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.30" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>
        <Border x:Name="PillHighlight" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                CornerRadius="19" BorderThickness="1,1,1,0" IsHitTestVisible="False"/>

        <!-- Ícones -->
        <StackPanel x:Name="Items" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>

        <!-- Balão com o nome do app -->
        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Border x:Name="Label" CornerRadius="7" Padding="11,4,11,5" Visibility="Collapsed"
                    Background="#E6303032" BorderBrush="#33FFFFFF" BorderThickness="1">
                <TextBlock x:Name="LabelText" FontSize="13" Foreground="#F5F5F7"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
